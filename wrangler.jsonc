{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "macro-argentina-dashboard",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-09-27",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  // v125: almacenamiento permanente de los últimos datos encontrados (Workers KV)
  "kv_namespaces": [
    { "binding": "MACRO_STORE", "id": "e8a8039f8ebd44eaac002420f0174a38" }
  ],
  // v125: revisión automática de las fuentes una vez por hora (ver scheduled() en src/worker.mjs)
  "triggers": {
    "crons": ["17 * * * *"]
  },
  "observability": {
    "enabled": true
  }
}
